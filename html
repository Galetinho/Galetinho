<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Flashcards do Brasil</title>
    <link rel="stylesheet" href="style.css"> </head>
<body>

    <main>
        <h1>Flashcards: Descobrindo o Brasil</h1>
        <div class="flashcard-container">

            <article class="flashcard">
                <div class="flashcard-category">Geografia</div>
                <div class="flashcard-content">
                    <div class="flashcard-question">Qual é a capital do Brasil?</div>
                    <div class="flashcard-answer">Brasília</div>
                </div>
            </article>

            <article class="flashcard">
                <div class="flashcard-category">História</div>
                <div class="flashcard-content">
                    <div class="flashcard-question">Em que ano o Brasil foi "descoberto" pelos portugueses?</div>
                    <div class="flashcard-answer">1500</div>
                </div>
            </article>

            <article class="flashcard">
                <div class="flashcard-category">Cultura</div>
                <div class="flashcard-content">
                    <div class="flashcard-question">Qual é o ritmo musical mais famoso do Brasil?</div>
                    <div class="flashcard-answer">Samba</div>
                </div>
            </article>

            <article class="flashcard">
                <div class="flashcard-category">Geografia</div>
                <div class="flashcard-content">
                    <div class="flashcard-question">Qual é o maior rio que passa pelo território brasileiro?</div>
                    <div class="flashcard-answer">Rio Amazonas</div>
                </div>
            </article>

            <article class="flashcard">
                <div class="flashcard-category">Curiosidades</div>
                <div class="flashcard-content">
                    <div class="flashcard-question">Qual o animal símbolo do Brasil?</div>
                    <div class="flashcard-answer">Onça-pintada</div>
                </div>
            </article>

        </div>
    </main>

    <footer>
        <p>&copy; 2025 Projeto Flashcard Brasil</p>
    </footer>

    <script src="script.js"></script> </body>
</html>
